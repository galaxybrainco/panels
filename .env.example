# Production storage/CDN. Bunny Storage is S3-compatible; leave the bucket unset in dev.
# Endpoint format: https://<region>-s3.storage.bunnycdn.com ; region is a Bunny code (de, ny, sg, uk, se, la, jh, syd).
# Set immutable Cache-Control on the pull zone (Bunny does not accept it via the S3 API).
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ENDPOINT_URL=
MEDIA_STORAGE_ACCESS_KEY=
MEDIA_STORAGE_SECRET_KEY=
MEDIA_STORAGE_REGION=de
MEDIA_STORAGE_CUSTOM_DOMAIN=

# Instance / federation
INSTANCE_ACTOR_HANDLE=instance
FEDERATION_ALLOWLIST_ENABLED=False
DJANGO_CSRF_TRUSTED_ORIGINS=
WEBSUB_HUB_URL=

# Media pipeline
MEDIA_MAX_UPLOAD_BYTES=25000000
MEDIA_DERIVATIVE_BACKEND=media.derivative_urls.LocalDerivativeBackend
MEDIA_CDN_BASE_URL=
# Legacy S3-compatible aliases (prefer MEDIA_STORAGE_* below)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Billing (disabled by default; self-host installs leave these empty)
BILLING_ENABLED=False
BILLING_SUCCESS_URL=http://localhost:8000/
BILLING_CANCEL_URL=http://localhost:8000/
BILLING_PORTAL_RETURN_URL=http://localhost:8000/
BILLING_GRACE_DAYS=7
BILLING_ARCHIVE_AFTER_DAYS=90
BILLING_PRICE_MONTHLY=
BILLING_PRICE_ANNUAL=
BILLING_STORAGE_ADDON_PRICE=
BILLING_STORAGE_ADDON_BYTES=10737418240
BILLING_STORAGE_ADDON_MAX_UNITS=100
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Analytics (page-view capture off by default)
PAGE_VIEW_ANALYTICS_ENABLED=False
